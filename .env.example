# =============================================================================
# Arc Studio — environment
#
# Grouped by CAPABILITY, because the question that matters is not "what
# variables exist" but "what is switched off, and what does that cost me".
# Every variable is marked:
#
#   required  — the capability does not work at all without it
#   optional  — the capability works; this changes or extends it
#   platform  — describes this deployment, not a tenant's feature
#
# Copy to .env.local and fill in. Nothing here crashes the app when unset — a
# missing variable disables its capability and says so.
#
#   pnpm diagnose:env                  what is off right now, and why
#   pnpm diagnose:env --required-only  only what is actually broken
#
# One catalogue drives that command, the Settings -> Health console, and this
# file: src/domain/env-capabilities.ts. A test fails if this file and the
# catalogue drift apart, so add new variables THERE and mirror them here.
#
# Bringing up a new environment: docs/runbooks/go-live-checklist.md
# =============================================================================


# --- Persistence -------------------------------------------------------------
# Everything the app stores and reads back.
#
# Without these the app still validates and scores but does not persist: lead
# ingest returns 202 "not_configured" and read-models report "unavailable".
# MARKETING_* / NEXT_PUBLIC_MARKETING_* are accepted as aliases for all three.

# required — nothing persists; every read-model degrades.
NEXT_PUBLIC_SUPABASE_URL=
# required — no server-side write and no admin read succeeds.
SUPABASE_SERVICE_ROLE_KEY=
# required — browser-side auth cannot start a session.
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# --- Operator access ---------------------------------------------------------
# Who can reach the app, and who can administer the platform.

# optional — the auth gate.
#   supabase = REQUIRE SIGN-IN (full accounts + workspaces). Unauthenticated
#              requests redirect to /login; static assets and the auth pages
#              stay public. The intended production mode. Needs the Supabase
#              URL + anon key above.
#   operator = legacy shared operator gate (OPERATOR_* below).
#   open     = NO login, every page public (local demo / preview only).
# If supabase/operator is requested but its config is missing, the app falls
# back to "open" and logs a warning, so a misconfig cannot lock everyone out.
# In production this lives on Vercel, not in this file. (Alias: AUTH_MODE.)
ARC_AUTH_MODE=supabase
# optional — the legacy cookie gate. OPERATOR_ACCESS_TOKEN is the server-only
# session cookie secret; operators enter OPERATOR_EMAIL / OPERATOR_PASSWORD on
# the login screen. Unset is correct for local dev, not for a shared host.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OPERATOR_ACCESS_TOKEN=
OPERATOR_EMAIL=
OPERATOR_PASSWORD=
# optional — shown as the support contact in-app.
OPERATOR_SUPPORT_EMAIL=
# optional — whether strangers can create accounts. Unset keeps signup
# invite-only. Set to 1 only behind a completed launch checklist.
ARC_SELF_SERVE_SIGNUP=
# platform — comma-separated emails of the people who run the platform. Gates
# Settings -> Waitlist (waitlist_signups has no org_id, so it must never be
# visible to ordinary workspace admins) and Settings -> Health, which reads env
# readiness, connectors and the runner across EVERY workspace.
# Unset = NOBODY. The gate fails closed by design.
ARC_PLATFORM_ADMIN_EMAILS=


# --- Agent loop --------------------------------------------------------------
# Arc receives work, thinks, and writes back.
#
# When an operator sends Arc a chat message the app POSTs a small event to
# ARC_RUNNER_URL so Arc processes just that message and then sleeps — no
# background polling. The wake is best-effort: if it does not land the message
# stays queued and Arc catches up via GET /api/v1/arc/messages.

# required — POST /api/v1/arc/runs refuses with 503 until this is set, then
# requires `Authorization: Bearer <token>`.
ARC_AGENT_API_TOKEN=
# required — where the app wakes the runner, e.g.
# https://host:8644/webhooks/growth-chat. Unset means queued work is never
# picked up. (Legacy alias ARC_WEBHOOK_URL is still read as a fallback.)
ARC_RUNNER_URL=
# optional — shared secret. When set, the request body is signed with
# HMAC-SHA256 and sent as the `X-Webhook-Signature` header. Set it anywhere the
# runner is reachable from the internet.
ARC_WEBHOOK_SECRET=
# optional — what the attached agent is called in the UI. Defaults to "Arc".
# (The agent key to attach to comes from the DB agent_connections record.)
ARC_DISPLAY_NAME=

# NOTE: the runner's own half — ANTHROPIC_API_KEY / CLAUDE_CODE_OAUTH_TOKEN,
# APP_API_BASE_URL, PORT, WEBHOOK_PATH — lives in apps/arc-runner/.env.example.
# A merge to main deploys BOTH halves, so a go-live needs both files.


# --- Brain / semantic memory -------------------------------------------------
# Arc recalls what it has learned instead of starting cold.

# required — shared with the agent and media loops. Without it recall falls back
# to literal matching and the Brain contributes nothing semantic.
GEMINI_API_KEY=
# optional — embedding model override. Default: gemini-embedding-2 (current GA),
# output pinned to 768 dims to match pgvector. This is the escape hatch when a
# model is retired: text-embedding-004 was shut down 2026-01-14 and
# gemini-embedding-001 retired 2026-07-14, so do not use them. The Brain's
# "Refresh memory" button reports which model actually works.
GEMINI_EMBEDDING_MODEL=
# optional — model used when learning from uploaded brand documents.
BRAND_KNOWLEDGE_MODEL=


# --- Send loop ---------------------------------------------------------------
# Approved outbound actually leaves, and engagement comes back.
#
# All but EMAIL_UNSUBSCRIBE_SECRET are required, and half-configured is the
# dangerous state: a send with no webhook secret leaves and nothing comes back,
# which looks like success. None of this bypasses the human approval gate.
#
# These belong on Vercel + local ONLY. Do NOT set RESEND_* on the Cloud Run
# runner — the runner sends no email; the app performs every Resend send.

# required — master kill switch for real outbound (executeResendDispatch).
# Blank means campaign email never leaves the building, no matter what else is
# configured. Set to "1" only when deliberately ready — then send one test to
# yourself first. This is on top of the per-send approval gate and the
# per-connection toggle.
ARC_SEND_ENABLED=
# required — transport. Without it the Connections panel shows Resend as "not
# configured" and every send is blocked. A per-workspace key in the Vault also
# satisfies this; the env value is the deployment-wide fallback.
RESEND_API_KEY=
# required — the fallback From identity, e.g. "Arc <hello@yourdomain.com>". MUST
# be an address on a domain verified in Resend (DKIM/SPF/DMARC). For campaign
# sends the from-address comes from the Resend connection row's config.fromEmail
# (set via `pnpm configure:resend`); this is the fallback.
# (Alias: RESEND_FROM_EMAIL.)
RESEND_FROM=
# required — signing secret for the engagement webhook (POST /api/webhooks/resend).
# Create the endpoint in the Resend dashboard (Webhooks -> Add endpoint, events:
# delivered/opened/clicked/bounced/complained) and paste its whsec_... here.
# Without it the route answers 503, opens/clicks are never recorded, and sends
# look fire-and-forget.
RESEND_WEBHOOK_SECRET=
# optional — signs unsubscribe links. Unset, they fall back to being signed with
# SUPABASE_SERVICE_ROLE_KEY, so links still work. Set this to decouple them:
# rotating the service-role key otherwise invalidates every outstanding
# unsubscribe link, and a public link signature stays tied to a DB credential.
EMAIL_UNSUBSCRIBE_SECRET=
# required — absolute host for links inside sent mail.
# (Aliases: NEXT_PUBLIC_APP_URL, EMAIL_EXPORT_SITE_URL.)
NEXT_PUBLIC_SITE_URL=
# optional — also used to build Stripe Checkout/Portal return links. When unset
# those are derived from the request host.
NEXT_PUBLIC_APP_URL=
# optional — branding for `pnpm email:export` (the hosted Supabase auth template
# generator). Defaults to "Arc" with no logo.
EMAIL_EXPORT_APP_NAME=
EMAIL_EXPORT_LOGO_URL=


# --- Media generation --------------------------------------------------------
# Arc drafts creative as approval-gated assets.
#
# Generated images land in the public `campaign-media` Supabase bucket, tagged
# ai_generated, risk-flagged, and arrive as approval-gated drafts. Per-workspace
# connectors are the modern path and do NOT need ARC_MEDIA_ENABLED.

# optional — legacy deployment-wide switch; set to "1" for the old path.
ARC_MEDIA_ENABLED=
# optional — image model override. Default: imagen-4.0-generate-001 (best
# photoreal text-to-image). Others: imagen-4.0-ultra-generate-001 (max quality,
# slower and pricier), gemini-2.5-flash-image (Nano Banana: editing + reference
# images).
GEMINI_IMAGE_MODEL=
# optional — Veo model for `generate_video`. Default: veo-2.0-generate-001.
GEMINI_VIDEO_MODEL=
# optional — reference-image uploads via Google Cloud Storage. The browser
# uploads straight to the bucket with a v4 signed URL; image bytes never touch
# the app server. Unset disables photo upload (the attach button says so).
#   GCS_SERVICE_ACCOUNT_KEY is the service-account JSON, base64-encoded, one line:
#     bash:       base64 -w0 key.json
#     PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.json"))
GCS_BUCKET=
GCS_SERVICE_ACCOUNT_KEY=


# --- Scheduled work ----------------------------------------------------------
# Daily scans and notices run without a human.

# required — set in Vercel and auto-sent by Vercel Cron as
# `Authorization: Bearer <CRON_SECRET>`. The cron routes fail closed without it,
# so nothing runs on a schedule at all. Leave unset locally.
CRON_SECRET=
# optional — the daily scheduled opportunity scan. Off by default.
OPPORTUNITY_SCAN_CRON_ENABLED=
# optional — daily billing email: trial warnings/expiry and usage warnings at
# 80%/100%, transactional, to workspace owners only. Needs CRON_SECRET and
# Resend configured.
BILLING_NOTICES_CRON_ENABLED=
# optional — lets the daily scan DRAFT from what it finds. Drafts remain
# approval-gated; this never sends anything.
OPPORTUNITY_AUTO_DRAFT_ENABLED=
# optional — set to 1 to log intended drafts without creating them.
OPPORTUNITY_AUTO_DRAFT_DRY_RUN=
# optional — minimum confidence (0-100) an opportunity must score to reach the
# inbox. Blank uses the default (50 baseline, with crm_inactivity held to 60
# since it out-produces every other detector combined). Raise it for a workspace
# whose inbox is too noisy; it lifts every kind, including ones with their own
# higher floor. Detection is unaffected — this filters what gets persisted, and
# the number rejected is reported, never silent.
ARC_OPPORTUNITY_CONFIDENCE_FLOOR=


# --- Billing -----------------------------------------------------------------
# Strangers can subscribe, and quotas mean something.
#
# The platform pays all provider API credits and bills each tenant; plans and
# monthly caps live in org_plans and are enforced against the ai_usage_events
# ledger. Leave STRIPE_SECRET_KEY blank and all billing UI/actions are hidden,
# with the Settings plan picker falling back to a manual (dev/comp) override.
#   1. Create one recurring monthly Price per paid tier and paste the ids below
#      (free has no price).
#   2. Add a webhook endpoint -> https://your-app.example.com/api/webhooks/stripe
#      subscribed to customer.subscription.created/updated/deleted; paste its
#      signing secret as STRIPE_WEBHOOK_SECRET.
#   3. Set ARC_BILLING_ENFORCEMENT=1 only when you want caps to BLOCK.

# required — checkout, portal, and webhook handling.
STRIPE_SECRET_KEY=
# required — verifies subscription events. Without it entitlements never sync
# after payment, so a paying customer stays on the free tier.
STRIPE_WEBHOOK_SECRET=
# required — one price id per plan, or that plan cannot be checked out.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SCALE=
# optional — master switch for BLOCKING over-cap usage. Blank means quotas are
# computed and displayed but never block (safe default). Set to "1" to actually
# refuse Arc runs / media generation once an org is over its monthly cap.
ARC_BILLING_ENFORCEMENT=


# --- Connector OAuth ---------------------------------------------------------
# Tenants connect their own accounts. All optional: without them a connector
# falls back to a manual token form, or is simply unavailable.

# optional — enables "Connect with HubSpot" instead of the private-app-token form.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# optional — enables "Connect with Google" on the reviews connector.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# optional — Google Drive manual import. Create the app-level Google OAuth
# client and add the callback:
#   https://your-app.example.com/api/integrations/google-drive/callback
# GOOGLE_DRIVE_REDIRECT_URI is optional; unset derives it from the current
# origin. Each operator connects their own Google account at runtime; imports
# are manual selected-file copies into Library, not background folder sync.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=
# optional — the in-app "Choose from Drive" browser. Restrict the API key to the
# Google Picker / Drive APIs and your app domains. The app id is the Google
# Cloud project NUMBER, not the OAuth client id.
GOOGLE_DRIVE_PICKER_API_KEY=
GOOGLE_DRIVE_APP_ID=
# optional — Weather Signals connector (NWS/NOAA); no API key needed.
# api.weather.gov asks every client for a descriptive User-Agent with a contact.
# A sensible default is used if unset. Free-form, e.g.
# "MyApp/1.0 (contact: ops@example.com)".
NWS_USER_AGENT=


# --- Social publishing -------------------------------------------------------
# Approved posts can reach Meta, X and LinkedIn. Full acquisition steps:
# docs/social-connections-setup.md. A provider flips to "Connected" in the
# Connections panel once ALL of its variables are set — a partial set reports an
# auth error at send rather than a configuration one, so set them together.

# optional — Meta. ONE app powers both Facebook Page and Instagram publishing.
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=               # Facebook Page to post as   -> gates Facebook
META_PAGE_ACCESS_TOKEN=     # long-lived Page token      -> gates Facebook + Instagram
META_IG_USER_ID=            # Instagram Business acct id -> gates Instagram
# optional — LinkedIn. OAuth2 access token + the org page to post as.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_URN=           # e.g. urn:li:organization:12345
# optional — X (Twitter). OAuth 1.0a user context, write access.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=


# --- Inbound APIs ------------------------------------------------------------
# External systems push leads, results and media in.
#
# Each is optional in that the route works without it — but unset means the
# route is OPEN. That is a dev convenience and a hole on any shared host.

# optional — POST /api/v1/leads/ingest. Unset leaves it open.
LEADS_INGEST_API_TOKEN=
# optional — POST /api/v1/campaigns/results. Unset leaves it open.
CAMPAIGN_RESULTS_API_TOKEN=
# optional — POST /api/v1/media, the bring-your-own-tools media on-ramp. Pushed
# media is risk-scanned, provenance-tagged, and HELD FOR REVIEW: it never
# auto-arms Arc reuse. Workspace tokens with the media:ingest scope also work.
# Required once Supabase persistence is configured.
MEDIA_INGEST_API_TOKEN=


# --- Observability -----------------------------------------------------------
# A failure reaches a human instead of a log nobody reads.

# required — Sentry DSN. With no DSN the SDK initialises disabled and sends
# nothing, so failures land nowhere a human looks. The DSN is public by design
# (it ships in the browser bundle) — it identifies the project, it is not a
# secret. Setting it in Vercel needs a rebuild, not a code change.
NEXT_PUBLIC_SENTRY_DSN=
# required — platform failure alerts to Slack, via a free Incoming Webhook.
# Primary-surface read failures and Arc runner failures post here, muted per
# scope for 15 minutes so one broken query cannot flood the channel. Unset means
# failures still reach Sentry and the server log but NOBODY IS PAGED — the state
# that let a broken campaigns board sit unnoticed for hours.
# PLATFORM-level: this must not be a tenant's webhook. The per-workspace
# `slack-alerts` connector is a separate, operator-triggered thing.
ALERT_SLACK_WEBHOOK_URL=
# optional — overrides the auto-detected environment (defaults to VERCEL_ENV,
# else "development"), so prod and preview noise stay separate.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# optional — 0-1. Defaults to 0.1: errors are the point, traces bill per event.
# Blank or invalid falls back to the default rather than silently becoming 0.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# platform — source-map upload at build time, so prod stack traces show real
# lines instead of minified soup. Only used when SENTRY_AUTH_TOKEN is present;
# the build is a clean pass-through without it, which is how CI builds env-less.
# SENTRY_AUTH_TOKEN *is* a secret — keep it out of the client.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=


# --- Demo & preview ----------------------------------------------------------
# Sales demos and the backend-less local preview.

# optional — set to 1 ONLY for demos and local preview. It substitutes demo
# fixtures for an EMPTY state. A real read failure still reports as a failure
# (BSR-575) — fixtures never stand in for an outage.
ARC_DEMO_DATA=
# optional — industry vocabulary for the demo tenant.
ARC_DEMO_INDUSTRY=
# optional — COSMETIC. Names the synthetic org in the offline demo context. It
# does NOT select a tenant: a session-less request resolves the sole org in the
# database and refuses when there is more than one rather than guessing.
DEFAULT_ORG_SLUG=big-shoulders-restoration


# --- Site verification -------------------------------------------------------
# platform — ownership-verification tokens, rendered as <meta> tags on every
# page. Google: Search Console -> Settings -> Ownership verification -> HTML tag
# (copy only the content="..." value). Bing: Bing Webmaster Tools. Unset means
# the tag is simply omitted. Needs a redeploy to take effect.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
